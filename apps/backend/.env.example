# AILIZA — Konfigurationsvorlage fuer den autarken (lokalen) Betrieb
#
# ANLEITUNG
#   1. Diese Datei kopieren:  cp apps/backend/.env.example .env
#   2. Werte eintragen (siehe unten)
#   3. In docker-compose.yml unter "ailiza:" ergaenzen:  env_file: .env
#   4. Starten:  docker compose up -d
#
# WICHTIG
#   Die fertige .env-Datei enthaelt Geheimnisse und darf NIEMALS nach GitHub.
#   Sie ist in .gitignore bereits blockiert (.env, .env.*, *.env) -- diese
#   Vorlage hier ist bewusst die einzige Ausnahme und enthaelt keine echten Werte.
#   Ebenfalls nie ins Repo: die Datenbankdatei (*.db, *.sqlite) mit deinen
#   Chats, Nutzern und Logs. Personenbezogene Daten in einem Repository waeren
#   selbst ein DSGVO-Verstoss.


# ---------------------------------------------------------------------------
# PFLICHT
# ---------------------------------------------------------------------------

# Mindestens 32 Zeichen. Ohne diesen Wert ist die Anmeldung deaktiviert.
# Erzeugen:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ACHTUNG: Aus diesem Schluessel wird auch der Schluessel abgeleitet, mit dem
# Chattitel und Chatinhalte verschluesselt in der Datenbank liegen
# (governance/field_crypto.py). Aenderst du ihn spaeter, sind alle bereits
# gespeicherten Chats unlesbar. Einmal setzen, sicher aufbewahren, nicht mehr
# aendern.
AILIZA_SECRET_KEY=

# Speicherort der Datenbank.
# Im Docker-Betrieb ist der Wert bereits in docker-compose.yml gesetzt
# (sqlite:////data/ailiza.sqlite) und muss hier NICHT wiederholt werden.
# Nur fuer den Start ohne Docker setzen, dann mit absolutem Pfad:
# AILIZA_DATABASE_URL=sqlite:////home/DEINNAME/ailiza/ailiza.sqlite


# ---------------------------------------------------------------------------
# EXTERNE SPRACHMODELLE
# ---------------------------------------------------------------------------
#
# Standard ist "false" (in docker-compose.yml gesetzt): AILIZA sendet dann
# NICHTS nach draussen. Das ist die datenschutzfreundlichste Einstellung --
# AILIZA beantwortet in diesem Zustand allerdings auch keine Fragen ueber ein
# Sprachmodell.
#
# Auf "true" setzen heisst: Anfragen gehen an externe Anbieter (Groq, OpenAI,
# Anthropic -- US-Anbieter). Das ist eine Datenuebermittlung. AILIZA schwaerzt
# personenbezogene Daten vorher (Redaction) und prueft die Freigabe
# (Policy-Gateway), aber ein Auftragsverarbeitungsvertrag (AVV) mit dem
# jeweiligen Anbieter ist zusaetzlich erforderlich.
AILIZA_EXTERNAL_LLM_ENABLED=false

# API-Schluessel -- nur noetig, wenn oben "true" gesetzt ist.
# Leer lassen, was nicht genutzt wird.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Reihenfolge, in der Anbieter versucht werden (Komma-getrennt).
# AILIZA_PROVIDER_ORDER=groq,openai,anthropic


# ---------------------------------------------------------------------------
# BETRIEB
# ---------------------------------------------------------------------------

# production oder development. Im Docker-Betrieb bereits gesetzt.
# AILIZA_ENV=production

# Erlaubte Herkunft fuer Browser-Zugriffe. Lokal genuegt der Standard.
# AILIZA_CORS_ORIGINS=http://localhost:8000

# Mandantenkennung. Nur aendern, wenn mehrere Mandanten getrennt werden sollen.
# AILIZA_DEFAULT_TENANT_ID=default

# Nur bei Betrieb hinter HTTPS aktivieren. Lokal aus lassen.
# AILIZA_FORCE_HTTPS=false


# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Eigener Schluessel fuer die Feldverschluesselung (32 Byte, base64).
# Ohne diesen Wert wird er aus AILIZA_SECRET_KEY abgeleitet -- das genuegt.
# Erzeugen:  python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# AILIZA_FIELD_ENCRYPTION_KEY=

# Texterkennung in Bildern (OCR). Laeuft rein lokal, nichts wird gesendet.
# Benoetigt die Zusatzpakete aus requirements-full.txt (MODE=full im Dockerfile).
# AILIZA_LOCAL_OCR_ENABLED=false

# Zugangsdaten der Verwaltungsoberflaeche (/admin/*).
# AILIZA_ADMIN_USER=
# AILIZA_ADMIN_PASSWORD=
